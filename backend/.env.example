PORT=5000
APP_BASE_URL=http://localhost:5173
MASTER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/MASTER_DB?sslmode=require
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=2h

# Neon API provisioning settings. Required for database-per-organization signup.
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_BRANCH_ID=
# Database owner role configured in Neon. If blank, provisioning adapter uses the default owner returned/configured for the project.
NEON_DATABASE_OWNER=

# Connection parameters used to connect to a newly provisioned tenant DB.
# Host/user/password are taken from this URL; database name is replaced with the server-generated tenant database name.
TENANT_CONNECTION_BASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
